{
  "name": "emilkrebs-website",
  "version": "0.2.3",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:site": "npm run build:images && NEXT_PUBLIC_PLAYGROUND_URL=http://localhost:5199 next dev",
    "dev:playground": "npm --prefix playground run dev",
    "build": "npm run build:playground && npm run build:images && next build",
    "build:playground": "npm --prefix playground run build",
    "build:images": "node scripts/optimize-images.mjs",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "clean": "rm -rf .next node_modules package-lock.json && npm install"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "next": "16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "workspaces": [
    "playground"
  ]
}
